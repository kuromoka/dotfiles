{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "512000"
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/**.env)",
      "Edit(~/.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/**.env)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "language": "japanese",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
